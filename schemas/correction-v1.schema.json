{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esports-landscape.example/schemas/correction-v1.schema.json",
  "title": "PII-free append-only correction or withdrawal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "correction_id", "snapshot_id", "sequence", "action", "target", "reason_code", "recorded_at", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "correction_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "action": {"enum": ["correction", "withdrawal"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "prior_digest"],
      "properties": {
        "kind": {"enum": ["claim", "subject", "publication"]},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
        "prior_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "replacement_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_digest", "policy_version"],
      "properties": {
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "correction"}}},
      "then": {"required": ["replacement_digest"]},
      "else": {"not": {"required": ["replacement_digest"]}}
    }
  ]
}
