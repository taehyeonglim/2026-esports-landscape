{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esports-landscape.example/schemas/run-report-v1.schema.json",
  "title": "PII-free operational metrics run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_kind", "started_at", "finished_at", "outcome", "input_digest", "metrics", "reason_codes"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "run_kind": {"enum": ["collect", "audit", "publish", "withdrawal", "budget"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["pass", "soft_stop", "hard_stop", "failed"]},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "uniqueItems": true},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduled", "attempted", "succeeded", "failed", "quarantined", "published", "withdrawn", "duration_ms"],
      "properties": {
        "scheduled": {"type": "integer", "minimum": 0},
        "attempted": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "quarantined": {"type": "integer", "minimum": 0},
        "published": {"type": "integer", "minimum": 0},
        "withdrawn": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_digest"],
      "properties": {
        "status": {"enum": ["PASS", "SOFT", "HARD"]},
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "projected_minutes": {"type": "integer", "minimum": 0},
        "storage_headroom_gb_hours": {"type": "number"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "pass"}}},
      "then": {
        "required": ["output_digest"],
        "properties": {"reason_codes": {"maxItems": 0}}
      },
      "else": {
        "properties": {"reason_codes": {"minItems": 1}}
      }
    }
  ]
}
