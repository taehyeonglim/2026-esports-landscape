{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esports-data.example/schemas/snapshot-v3.schema.json",
  "title": "Immutable esports data snapshot v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "schema_hash", "policy_hash", "revision", "epoch", "records", "evidence", "sources"],
  "properties": {
    "snapshot_id": {"$ref": "#/$defs/sha256"},
    "schema_hash": {"$ref": "#/$defs/sha256"},
    "policy_hash": {"$ref": "#/$defs/sha256"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "epoch": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "records": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/record"}},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "sources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "opaqueId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sanitizedHttpsUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "subject_id", "status", "claims", "evidence_ids", "source_ids"],
      "properties": {
        "record_id": {"$ref": "#/$defs/opaqueId"},
        "subject_id": {"$ref": "#/$defs/opaqueId"},
        "status": {"enum": ["verified", "provisional"]},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "kind", "value", "evidence_id", "source_id"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/opaqueId"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {
          "oneOf": [
            {"type": "string", "maxLength": 2048},
            {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991},
            {"type": "boolean"}
          ]
        },
        "evidence_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_id", "url", "observed_at", "checksum"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "url": {"$ref": "#/$defs/sanitizedHttpsUri"},
        "observed_at": {"type": "string", "format": "date-time"},
        "checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "tier", "url"],
      "properties": {
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "tier": {"enum": ["core", "discovery"]},
        "url": {"$ref": "#/$defs/sanitizedHttpsUri"}
      }
    }
  }
}
