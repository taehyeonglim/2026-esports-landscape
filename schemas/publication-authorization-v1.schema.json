{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esports-landscape.example/schemas/publication-authorization-v1.schema.json",
  "title": "PII-free publication authorization v1",
  "description": "Binds a sanitized projection request and execution context to verified control-plane artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_receipt_sha256",
    "parent_git_sha",
    "output_revision",
    "sqlite_file_sha256",
    "policy_hash",
    "schema_sha256",
    "migration_sha256",
    "correction_epoch",
    "stop_epoch",
    "projection_request_sha256",
    "quality_report_sha256",
    "quality_passed",
    "budget_report_sha256",
    "budget_status",
    "expected_current",
    "operation",
    "repository",
    "workflow_ref",
    "target_ref",
    "workflow_sha",
    "target_sha",
    "environment",
    "output_dir",
    "nonce_ledger",
    "readback_origin",
    "nonce",
    "issued_at",
    "freshness_seconds",
    "signature_hmac_sha256"
  ],
  "properties": {
    "command_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "output_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sqlite_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "migration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "correction_epoch": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "stop_epoch": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1, "maxLength": 128}]},
    "projection_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quality_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quality_passed": {"const": true},
    "budget_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "budget_status": {"const": "PASS"},
    "expected_current": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "operation": {"enum": ["normal", "emergency"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "workflow_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "target_ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
    "workflow_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "target_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "environment": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "output_dir": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
    "nonce_ledger": {"const": ".publication-nonces"},
    "readback_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 512},
    "issued_at": {"type": "string", "format": "date-time"},
    "freshness_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "signature_hmac_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
