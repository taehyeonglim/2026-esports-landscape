{
  "name": "2026-esports-landscape",
  "private": true,
  "type": "module",
  "config": {
    "githubPagesBase": "/2026-esports-landscape/"
  },
  "scripts": {
    "extract": "node scripts/extract-data.mjs",
    "validate": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit.test.mjs tests/stat-ribbon.test.mjs",
    "test:e2e": "node scripts/build.mjs && node --test tests/e2e-contract.test.mjs",
    "e2e": "npm run test:e2e",
    "test:browser": "npm run build && playwright test",
    "verify:release": "npm run extract && npm run validate && npm test && npm run test:e2e && npm run test:browser && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.17.1"
  }
}
